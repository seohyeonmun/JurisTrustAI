rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string && 
             data.email is string && data.email.size() <= 256;
    }

    // Collections
    match /users/{userId} {
      // Users can read their own profile
      allow get: if isOwner(userId) && isValidId(userId);
      
      // Users can create/update their own profile
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && 
                      isValidId(userId) &&
                      isValidUser(request.resource.data) &&
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'displayName', 'photoURL', 'email', 'phoneNumber']);

      
      // Prevent bulk listing of users
      allow list: if false;
    }
  }
}
